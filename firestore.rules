rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity helpers -------------------------------------------------

    // Only verified emails count. Email-link sign-in produces a verified email.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // The admin can read every profile and is the only account allowed to
    // create profiles or change who may see them.
    function isAdmin() {
      return isVerified() && userEmail() == 'taruntejthadana@gmail.com';
    }

    // True when the signed-in user's email is on this profile's allow-list.
    function isAllowed(profileId) {
      return isVerified()
        && userEmail() in get(/databases/$(database)/documents/profiles/$(profileId)).data.allowedEmails;
    }

    // ---- Per-profile data -------------------------------------------------
    match /profiles/{profileId} {
      // Single-document read: profileId is a concrete id, so isAllowed()'s
      // get() can resolve. Anyone on the allow-list (or the admin) may read it.
      allow get:            if isAdmin() || isAllowed(profileId);

      // Collection query: on a list the {profileId} wildcard is NOT bound to a
      // document id, so isAllowed()'s get() cannot resolve and would reject the
      // whole query. Check the document itself instead. The client query is
      // constrained with `allowedEmails array-contains <email>`, so every
      // result is a profile the caller is actually allow-listed on.
      allow list:           if isAdmin()
                            || (isVerified() && userEmail() in resource.data.allowedEmails);

      // Open sign-up: any verified user may create their own profile, as long
      // as they put their own email on the allow-list so they can use it.
      // Changing the allow-list or deleting a profile stays admin-only.
      allow create:         if isAdmin()
                            || (isVerified() && userEmail() in request.resource.data.allowedEmails);
      allow update, delete: if isAdmin();

      // Sessions, resources, and any future subcollection: an allowed member
      // may read and write their own profile's data; the admin may do anything.
      match /{document=**} {
        allow read, write: if isAdmin() || isAllowed(profileId);
      }
    }

    // ---- Profile groups ---------------------------------------------------
    // Admin-only bookkeeping. Grouping is enforced for data access by
    // denormalising the combined member emails into each grouped profile's
    // allowedEmails list, so the rules above need no group-specific logic.
    match /groups/{groupId} {
      allow read, write: if isAdmin();
    }

    // ---- Default deny -----------------------------------------------------
    // Everything else, including the legacy users/{uid} tree, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
