rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Post-workout photos live under profiles/{profileId}/...
    // Access mirrors firestore.rules: the admin, or anyone whose verified
    // email is on that profile's allowedEmails list (which includes grouped
    // profiles, since group access is denormalised into allowedEmails).
    match /profiles/{profileId}/{allPaths=**} {
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'taruntejthadana@gmail.com';
      }
      function isAllowed() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in
             firestore.get(/databases/(default)/documents/profiles/$(profileId)).data.allowedEmails;
      }

      allow read: if isAdmin() || isAllowed();
      allow write: if (isAdmin() || isAllowed())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
